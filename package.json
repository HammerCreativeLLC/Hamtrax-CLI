{
  "name": "hamtrax",
  "version": "0.2.0",
  "description": "Hamtrax CLI and MCP server — inspect logbooks, log POTA contacts, and manage activations.",
  "type": "module",
  "license": "MIT",
  "author": "Hamtrax",
  "homepage": "https://hamtrax.com/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HammerCreativeLLC/Hamtrax-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/HammerCreativeLLC/Hamtrax-CLI/issues"
  },
  "keywords": [
    "ham-radio",
    "amateur-radio",
    "pota",
    "cli",
    "hamtrax",
    "logging",
    "mcp",
    "model-context-protocol"
  ],
  "main": "./dist/cli.js",
  "bin": {
    "hamtrax": "./dist/cli.js",
    "hamtrax-mcp": "./dist/mcp/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./mcp": {
      "import": {
        "types": "./dist/mcp/server.d.ts",
        "default": "./dist/mcp/server.js"
      },
      "require": {
        "types": "./dist-cjs/mcp/server.d.ts",
        "default": "./dist-cjs/mcp/server.js"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/util/http.d.ts",
        "default": "./dist/util/http.js"
      },
      "require": {
        "types": "./dist-cjs/util/http.d.ts",
        "default": "./dist-cjs/util/http.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mcp": ["dist/mcp/server.d.ts"],
      "http": ["dist/util/http.d.ts"]
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "postbuild": "node scripts/finishBuild.mjs",
    "dev": "tsx watch src/cli.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
